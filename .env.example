# RAG demo environment variable template
# Copy the KEYS you need into Vercel > rag-demo > Settings > Environment Variables.
# Choose Production for the cloud RAG platform.
# Never put actual tokens, database passwords, or API keys in this tracked file.
# An empty value means "not configured"; replace it only in the Vercel dashboard.
#
# CLOUD RAG PLATFORM (platform_app.py + platform_core.py + rag.py)
# RAG_MODE=production requires persistent PostgreSQL storage.
RAG_MODE=production

# Neon PostgreSQL connection string. Required for production document retrieval.
# Obtain the complete connection string from your own Neon project.
DATABASE_URL=

# Organization scope: choose a non-secret identifier and use it consistently.
RAG_ORG=

# Distinct strong access tokens for the REST API; not the Telegram bot token.
# RAG_READ_TOKEN: GET /knowledge-bases and POST /search, /ask, /query.
# RAG_WRITE_TOKEN: POST /ingest (document uploads).
RAG_READ_TOKEN=
RAG_WRITE_TOKEN=

# TELEGRAM BOT (platform_app.py + telegram_registration.py)
# Telegram bot token from BotFather. Keep secret.
TELEGRAM_BOT_TOKEN=

# The Telegram private chat ID permitted to interact with the bot.
# A numeric ID, not @botusername. Keep this out of a public example file.
TELEGRAM_CHAT_ID=

# Long random secret that Telegram sends in
# X-Telegram-Bot-Api-Secret-Token; must match Telegram's registration.
TELEGRAM_WEBHOOK_SECRET=

# The verified production URL; application checks/registers it in the cloud.
TELEGRAM_WEBHOOK_URL=https://rag-demo-gamma.vercel.app/telegram/webhook

# Knowledge base to search for Telegram questions; must match ingested KB.
TELEGRAM_KNOWLEDGE_BASE=default

# LLM PROVIDER (platform_core.py)
# OpenAI-compatible HTTPS API base URL, normally ending in /v1.
# Example format only: https://provider.example/v1
LLM_BASE_URL=

# Exact model identifier supported by the selected LLM provider.
LLM_MODEL=

# Provider API key; leave blank ONLY if the provider supports no-key access.
LLM_API_KEY=

# LOCAL-ONLY STORAGE / ORIGINAL DEMO
# Not needed for the Vercel PostgreSQL cloud deployment.
# For a local platform run, use RAG_MODE=local and a writable SQLite path.
RAG_SQLITE_PATH=./rag_platform.sqlite3

# Original Docker/Streamlit/Chroma/Ollama demo (api.py + app.py).
CHROMA_PATH=./storage/chroma
OLLAMA_URL=http://localhost:11434
API_URL=http://localhost:8000

# Docker Compose defines HF_HOME internally as /app/storage/hf for the API.
# HF_HOME is not read by the Vercel cloud RAG platform.
# HF_HOME=./storage/hf
